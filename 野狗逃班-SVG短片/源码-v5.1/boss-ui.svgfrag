<g id="perfectBadge" class="hide" pointer-events="none"><rect width="260" height="37" rx="18" fill="#122c31" stroke="#79c9b5"/><text id="perfectText" x="130" y="25" font-size="17" fill="#b3f3da" text-anchor="middle">零受击 / 隐藏路线保持中</text></g>
<g id="bossHud" class="hide" pointer-events="none"><rect id="bossHudBg" width="850" height="89" rx="18" fill="#081326" stroke="#675c73" opacity=".94"/><text id="bossName" x="22" y="28" font-size="20" fill="#f3c6b0" font-weight="800">终审官 · 永不下班</text><text id="bossStageText" x="820" y="28" font-size="17" fill="#94c8c8" text-anchor="end">一阶段 / 考勤</text><rect id="bossHPTrack" x="24" y="43" width="600" height="12" rx="6" fill="#2d3048"/><rect id="bossHPBar" x="24" y="43" width="600" height="12" rx="6" fill="#e992a1"/><text id="bossHeartText" x="23" y="79" font-size="19" fill="#a8f5d4">耐心 ◆ ◆ ◆</text><text id="bossHPText" x="820" y="79" font-size="18" fill="#bcc8cb" text-anchor="end">12 / 12</text></g>
<g id="bossCallout" class="hide" pointer-events="none"><rect id="bossCalloutBg" width="580" height="56" rx="18" fill="#152b38" stroke="#f2bba0" opacity=".94"/><text id="bossCalloutText" x="290" y="37" font-size="24" text-anchor="middle" fill="#f3dcc1" font-weight="800">先躲攻击，再找破绽</text></g>
<g id="bossGate" class="hide"><rect id="gateVeil" width="1280" height="710" fill="#071325" opacity=".94"/><text id="gateKicker" x="640" y="170" font-size="21" text-anchor="middle" fill="#b0f2da" letter-spacing="4">120 秒 / 零受击完美通关</text><text id="gateTitle" x="640" y="266" font-size="64" font-weight="900" text-anchor="middle" fill="#ffe2b3">隐藏加场已解锁</text><text id="gateLine1" x="640" y="330" font-size="24" text-anchor="middle" fill="#d0dbd5">路已经跑完。但最后一台审批机还亮着。</text><text id="gateLine2" x="640" y="373" font-size="21" text-anchor="middle" fill="#a7bfbb">三阶段 / 有预警 / 三格耐心 / 失败可只重试 Boss</text><g id="fightBtn" class="button" role="button" tabindex="0" aria-label="挑战隐藏Boss"><rect width="260" height="78" rx="15" fill="#f3cd94" stroke="#ffe5b4"/><text x="130" y="50" text-anchor="middle" font-size="25" font-weight="850" fill="#18283a">拆掉审批机 →</text></g><g id="skipBossBtn" class="button" role="button" tabindex="0" aria-label="跳过挑战正常收工"><rect width="230" height="78" rx="15" class="pill"/><text x="115" y="50" text-anchor="middle" font-size="23" fill="#b2d6cd">今天先收工</text></g><text id="gateFoot" x="640" y="544" text-anchor="middle" font-size="18" fill="#819e9e">可选挑战，不拿你的完美通关做赌注。</text></g>
<g id="bossResult" class="hide"><rect id="bossResultVeil" width="1280" height="710" fill="#081529" opacity=".93"/><text id="bossResultKicker" x="640" y="163" font-size="20" text-anchor="middle" fill="#a6dbd6">挑战结束 / 主关完美成绩保留</text><text id="bossResultTitle" x="640" y="255" font-size="68" font-weight="900" text-anchor="middle" fill="#ffe1b0">今晚不打卡了</text><text id="bossResultLine" x="640" y="321" font-size="24" text-anchor="middle" fill="#cad8d2">它很吵。江风不管它。</text><text id="bossResultStats" x="640" y="377" font-size="22" text-anchor="middle" fill="#95d9c8">坚持 0 秒 / 命中 0 次</text><g id="retryBossBtn" class="button" role="button" tabindex="0" aria-label="只重试Boss"><rect width="240" height="78" rx="15" fill="#f3cd94" stroke="#ffe5b4"/><text x="120" y="50" text-anchor="middle" font-size="24" font-weight="800" fill="#18283a">只重试 Boss</text></g><g id="bossFinishBtn" class="button" role="button" tabindex="0" aria-label="领取片尾"><rect width="240" height="78" rx="15" class="pill"/><text x="120" y="50" text-anchor="middle" font-size="24" fill="#b2d6cd">领取片尾</text></g><text id="bossResultFoot" x="640" y="537" text-anchor="middle" font-size="18" fill="#8daaaa">不强迫你再跑两分钟。耐心留给好玩的东西。</text></g>