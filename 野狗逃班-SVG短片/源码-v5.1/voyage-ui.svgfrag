<g id="voyageHUD" class="hide" pointer-events="none"><rect id="voyageHUDBG" width="690" height="66" rx="16" fill="#0c2432" stroke="#72b7a2" fill-opacity=".94"/><text id="voyageRouteLabel" x="18" y="24" fill="#f2d69c" font-size="17" font-weight="800">夜航</text><text id="voyageState" x="18" y="51" fill="#bfdfd5" font-size="18">夜航准备中</text></g>
